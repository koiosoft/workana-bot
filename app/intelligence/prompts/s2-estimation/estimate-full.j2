{#- Jinja2 template: estimate-full.j2
  Stage 2A — Technical Estimate Generator
  ---------------------------------------
  Consumes the Stage 1 ``RequirementAnalysis`` payload and produces purely
  technical numbers + structure (milestones / summary) consumed by Stage 3.
  No commercial or persuasive text is generated in this stage.

  REAL Stage 1 fields consumed (see app/models/analysis.py):
    - maturity_score            int, 1-10
    - maturity_reason           str
    - entities.technologies     list[str]
    - entities.deliverables     list[str]
    - entities.constraints      list[str]
    - gaps                      list[str]
    - branch                    "full" | "discovery"

  BUG FIXES applied in this revision
  ==================================
  1. Phantom fields. The previous version read ``analysis.requirements``,
     ``analysis.complexity``, ``analysis.delivery_pace`` and
     ``analysis.estimated_base_hours`` — none of which exist on the
     ``RequirementAnalysis`` model. They are now derived from real fields:
         req_count      = len(technologies) + len(deliverables)
         complexity     = high   if maturity_score >= 7
                          medium if 4 <= maturity_score <= 6
                          low    if maturity_score <= 3
         delivery_pace  = urgent    if len(gaps) >= 4
                          expedited if len(gaps) >= 2
                          standard  otherwise

  2. Context type. Callers pass ``analysis_json=json.dumps(analysis)`` — i.e. a
     JSON *string*. In Jinja, attribute access on a string yields Undefined
     rather than raising, so every field above silently resolved to its default
     and the arithmetic collapsed. The block below therefore accepts either a
     mapping or a JSON string and normalises to a mapping.

  3. Hours invariant. ``_assert_hours_consistency`` requires
     ``summary.total_hours`` to equal the sum of the milestone hours (tolerance
     0.5h) AND each milestone's hours to equal the sum of its own tasks. The old
     template applied the overhead multiplier per milestone on top of an already
     safety-loaded total, inflating the rollup ~24% over ``total_hours`` and
     guaranteeing a PipelineError. Overhead is now applied exactly once at the
     total level, then split across milestones with the remainder distributed so
     the sums reconcile to the unit. Task slices inherit their parent
     milestone's hours for the same reason.

  4. Filter misuse. ``min``/``max`` are sequence-only filters in Jinja; the
     two-argument forms used previously (``x | min(y)``) raised
     ``TypeError: 'int' object is not iterable``. Clamping now uses
     ``[a, b] | max`` list form or explicit comparisons.

  5. Rounding. Every value that reaches ``| round`` is coerced with ``| int``
     first, so a string-typed input cannot raise
     ``jinja2.exceptions.UndefinedError: str object has no attribute ...`` /
     "str doesn't define __round__ method".
-#}
{%- set HOURLY_RATE = 45 -%}
{%- set MINIMUM_HOURS = 270 -%}
{%- set BASE_WEEKLY_HOURS = 40 -%}
{%- set OVERHEAD_MULTIPLIER = 1.25 -%}
{%- set COMPLEXITY_MULTIPLIERS = {"low": 1.0, "medium": 1.2, "high": 1.5} -%}
{%- set DELIVERY_MULTIPLIERS = {"standard": 1.0, "expedited": 1.3, "urgent": 1.6} -%}
{%- set MILESTONE_NAMES = ["Foundation & Setup", "Core Implementation", "Integration & Polish", "Deployment & Handover"] -%}

{#- ------------------------------------------------------------------ -#}
{#- Normalise context: accept a mapping OR a JSON string                -#}
{#- ------------------------------------------------------------------ -#}
{%- set _raw_analysis = analysis_json -%}
{%- if _raw_analysis is mapping -%}
  {%- set analysis = _raw_analysis -%}
{%- elif _raw_analysis is string and _raw_analysis | length > 0 -%}
  {#- Callers pass json.dumps(analysis); parse it so attribute access works. -#}
  {%- set analysis = _raw_analysis | fromjson -%}
{%- else -%}
  {%- set analysis = {} -%}
{%- endif -%}
{%- set entities = analysis.entities if analysis.entities is mapping else {} -%}

{#- ------------------------------------------------------------------ -#}
{#- Derive every driver from REAL Stage 1 fields                        -#}
{#- ------------------------------------------------------------------ -#}
{%- set technologies = entities.technologies | default([], true) -%}
{%- set deliverables = entities.deliverables | default([], true) -%}
{%- set constraints = entities.constraints | default([], true) -%}
{%- set gaps = analysis.gaps | default([], true) -%}

{%- set tech_count = technologies | length -%}
{%- set deliv_count = deliverables | length -%}
{%- set gap_count = gaps | length -%}
{%- set req_count = tech_count + deliv_count -%}

{%- set raw_score = analysis.maturity_score | default(5) | int -%}
{%- if raw_score >= 7 -%}
  {%- set complexity = "high" -%}
{%- elif raw_score >= 4 -%}
  {%- set complexity = "medium" -%}
{%- else -%}
  {%- set complexity = "low" -%}
{%- endif -%}

{%- if gap_count >= 4 -%}
  {%- set delivery_pace = "urgent" -%}
{%- elif gap_count >= 2 -%}
  {%- set delivery_pace = "expedited" -%}
{%- else -%}
  {%- set delivery_pace = "standard" -%}
{%- endif -%}

{%- set complexity_mult = COMPLEXITY_MULTIPLIERS[complexity] | default(1.2) -%}
{%- set delivery_mult = DELIVERY_MULTIPLIERS[delivery_pace] | default(1.0) -%}

{#- ------------------------------------------------------------------ -#}
{#- Hour math. Overhead is applied ONCE here, so total_hours and the    -#}
{#- milestone rollup can never drift apart.                            -#}
{#- ------------------------------------------------------------------ -#}
{%- set effective_req_count = [req_count, 1] | max -%}
{%- set base_hours = (effective_req_count * 16 * complexity_mult * delivery_mult) | int -%}
{%- set core_hours = [base_hours, MINIMUM_HOURS] | max -%}
{%- set total_hours = (core_hours * OVERHEAD_MULTIPLIER) | int -%}

{%- if total_hours < 200 -%}
  {%- set milestone_count = 2 -%}
{%- elif total_hours <= 500 -%}
  {%- set milestone_count = 3 -%}
{%- else -%}
  {%- set milestone_count = 4 -%}
{%- endif -%}
{%- set milestone_count = [milestone_count, MILESTONE_NAMES | length] | min -%}

{#- Integer split; the remainder is spread one hour at a time over the   -#}
{#- leading milestones so that sum(milestone hours) == total_hours       -#}
{#- exactly, which is what validate_hours_consistency asserts.           -#}
{%- set milestone_base = (total_hours / milestone_count) | int -%}
{%- set remainder = total_hours - (milestone_base * milestone_count) -%}

{%- set delivery_weeks = [(total_hours / BASE_WEEKLY_HOURS) | round(0, 'ceil') | int, 1] | max -%}
{%- set total_budget = (total_hours * HOURLY_RATE) | round(2) -%}

{#- ------------------------------------------------------------------ -#}
{#- Milestone construction                                              -#}
{#- ------------------------------------------------------------------ -#}
{%- set all_items = [] -%}
{%- for item in technologies -%}{%- set _ = all_items.append(item | string) -%}{%- endfor -%}
{%- for item in deliverables -%}{%- set _ = all_items.append(item | string) -%}{%- endfor -%}
{%- set item_count = all_items | length -%}

{%- set milestones = [] -%}
{%- for i in range(milestone_count) -%}
  {%- set step = i + 1 -%}
  {%- set ms_name = MILESTONE_NAMES[i] -%}
  {%- set ms_hours = milestone_base + (1 if i < remainder else 0) -%}
  {%- set ms_subtotal = (ms_hours * HOURLY_RATE) | round(2) -%}

  {#- Slice the extracted items across milestones. When there are fewer    -#}
  {#- items than milestones the later milestones fall back to a generic    -#}
  {#- task, but the milestone's own hours always equal its task sum.       -#}
  {%- if item_count > 0 -%}
    {%- set slice_start = ((i * item_count) / milestone_count) | int -%}
    {%- set slice_end = (((i + 1) * item_count) / milestone_count) | int -%}
  {%- else -%}
    {%- set slice_start = 0 -%}
    {%- set slice_end = 0 -%}
  {%- endif -%}
  {%- set slice_size = [slice_end - slice_start, 1] | max -%}
  {%- set task_hours = (ms_hours / slice_size) | int -%}
  {%- set task_remainder = ms_hours - (task_hours * slice_size) -%}

  {%- set tasks = {} -%}
  {%- if slice_end > slice_start -%}
    {%- for j in range(slice_start, slice_end) -%}
      {%- set item = all_items[j] -%}
      {%- set bonus = task_remainder if j == slice_start else 0 -%}
      {#- La clave incluye el indice global ``j`` a proposito: Stage 1 puede
          devolver items repetidos, y dos tareas con el mismo nombre colapsarian
          en una sola dict key, perdiendo horas y rompiendo
          validate_hours_consistency (milestone != suma de sus tasks). -#}
      {%- set _ = tasks.update({("task_" ~ (j + 1)): {
        "description": "Implementation of " ~ item,
        "hours_with_overhead": task_hours + bonus
      }}) -%}
    {%- endfor -%}
  {%- else -%}
    {%- set _ = tasks.update({("implementation_step_" ~ step): {
      "description": "General implementation work for " ~ ms_name,
      "hours_with_overhead": ms_hours
    }}) -%}
  {%- endif -%}

  {%- set _ = milestones.append({
    "step": step,
    "name": ms_name,
    "tasks": tasks,
    "hours_with_overhead": ms_hours,
    "subtotal": ms_subtotal
  }) -%}
{%- endfor -%}

{#- ------------------------------------------------------------------ -#}
{#- Derived signals echoed for Stage 3 / audit traceability             -#}
{#- ------------------------------------------------------------------ -#}
{%- set rationale = "Derived from Stage 1: maturity_score=" ~ raw_score ~ " -> complexity=" ~ complexity ~ "; gaps=" ~ gap_count ~ " -> delivery_pace=" ~ delivery_pace ~ "; req_count=" ~ req_count ~ " (" ~ tech_count ~ " technologies + " ~ deliv_count ~ " deliverables)." -%}
{
  "estimate_type": "full",
  "milestones": {{ milestones | tojson(indent=2) }},
  "summary": {
    "total_hours": {{ total_hours | int }},
    "total_budget": {{ total_budget }},
    "delivery_time_weeks": {{ delivery_weeks | int }},
    "hourly_rate_applied": {{ HOURLY_RATE | int }}
  },
  "assumptions": {{ ([rationale] + constraints | map('string') | list) | tojson }},
  "_debug": {
    "maturity_score": {{ raw_score | int }},
    "complexity": {{ complexity | tojson }},
    "delivery_pace": {{ delivery_pace | tojson }},
    "req_count": {{ req_count | int }},
    "gap_count": {{ gap_count | int }},
    "base_hours": {{ base_hours | int }},
    "core_hours": {{ core_hours | int }},
    "total_hours": {{ total_hours | int }},
    "milestone_count": {{ milestone_count | int }}
  }
}
