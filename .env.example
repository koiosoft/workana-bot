# =================================================================
#          PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# =================================================================
#
# Instrucciones:
# 1. Copia este contenido a un nuevo archivo llamado .env.local
# 2. Reemplaza los valores de ejemplo con tus credenciales reales.
#
# El sistema carga .env (para valores por defecto) y luego .env.local
# (para tus secretos), dando prioridad a .env.local.
#
# -----------------------------------------------------------------

# --- Configuración del Scraper ---
# Define el origen de los datos.
# Opciones: 'workana' (para producción), 'dummy' (para pruebas)
SCRAPER_SOURCE=workana

# --- Credenciales del Bot de Telegram ---
TELEGRAM_BOT_TOKEN=TU_TOKEN_DE_TELEGRAM_AQUI
MY_TELEGRAM_ID=TU_ID_DE_TELEGRAM_AQUI

# --- Inteligencia Artificial ---
# Proveedor: 'gemini' (por defecto) o 'openrouter'
AI_PROVIDER=gemini
GEMINI_API_KEY=TU_API_KEY_DE_GEMINI_AQUI
OPENROUTER_API_KEY=TU_API_KEY_DE_OPENROUTER_AQUI

# --- Configuración de la Base de Datos ---
# El host 'mongodb' es el nombre del servicio en docker-compose.yml.
# Esta es la URI recomendada para el entorno Docker.
MONGO_URI=mongodb://admin:super_password_123@mongodb:27017/
MONGO_DB_NAME=workana_bot

# --- Variables de Autenticación (JWT) ---
# Secret para firmar tokens JWT. USA una cadena larga y aleatoria en producción.
# En desarrollo funciona con un secreto por defecto.
AUTH_SECRET=change_this_to_a_random_secret_at_least_32_chars
AUTH_JWT_ALGORITHM=HS256
AUTH_TOKEN_EXPIRE_HOURS=24

# --- Entorno ---
# production: Requiere AUTH_SECRET configurado
# development: Usa secreto por defecto (solo para pruebas locales)
ENVIRONMENT=development

# --- Variables para la inicialización de la BD en Docker ---
# Usadas por docker-compose para crear el usuario inicial de la BD.
MONGO_USER=admin
MONGO_PASS=super_password_123

# --- Lógica de Negocio de Workana ---
# Ruta al archivo de sesión de Workana (DEBE ser un archivo, NO un directorio).
# Este archivo se genera ejecutando 'python scripts/extract_session.py'.
# Asegúrate de que la ruta apunte a un archivo .json, ej. /usr/src/app/state.json
STATE_FILE_PATH=/usr/src/app/state.json
# Puntuación mínima que debe tener un proyecto para enviar una propuesta automática.
MIN_SCORE_FOR_AUTO_SEND=90
# Conexiones disponibles en Workana.
CONNECTS_AVAILABLE=50
# Antigüedad máxima de los proyectos a considerar (en días).
MAX_PROJECT_DAYS=2
# Filtro de tiempo de publicación en Workana (ej. '1h', '1d', '1w').
WORKANA_PUBLICATION_FILTER=1w
# Número máximo de páginas a scrapear en cada ejecución.
WORKANA_MAX_PAGES=15
# Si es 'true', el scraper visitará la página de cada proyecto para más detalles.
WORKANA_VISIT_PROJECT_PAGES=false