# =============================================================================
# .env.prod.example — Plantilla de variables de PRODUCCION
# =============================================================================
#
# Uso en el servidor (NUNCA subir el .env real a git):
#   cp .env.prod.example .env
#   # editar .env con los valores reales de produccion
#
# Solo se listan las variables que DEBEN estar en produccion. Ver .env.example
# para el catalogo completo (stealth, filtros, etc.).
#
# check_prod.sh valida las marcadas como [OBLIGATORIA].
# =============================================================================

# --- Scraper ------------------------------------------------------------------
SCRAPER_SOURCE=workana                      # [OBLIGATORIA]

# --- Telegram -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=REEMPLAZAR               # [OBLIGATORIA]
MY_TELEGRAM_ID=REEMPLAZAR                   # [OBLIGATORIA]

# --- Inteligencia Artificial (al menos una API key) --------------------------
AI_PROVIDER=openrouter                      # o 'gemini'
OPENROUTER_API_KEY=REEMPLAZAR               # [OBLIGATORIA si AI_PROVIDER=openrouter]
GEMINI_API_KEY=REEMPLAZAR                   # [OBLIGATORIA si AI_PROVIDER=gemini]

# --- Base de datos ------------------------------------------------------------
# Produccion usa MongoDB Atlas. Ejemplo:
#   mongodb+srv://usuario:pass@cluster.mongodb.net/
MONGO_URI=mongodb://admin:REEMPLAZAR@mongodb:27017/   # [OBLIGATORIA]
MONGO_DB_NAME=workana_bot                             # [OBLIGATORIA]
# Solo si usas el mongodb local del compose:
MONGO_USER=admin
MONGO_PASS=REEMPLAZAR

# --- Auth / Entorno -----------------------------------------------------------
ENVIRONMENT=production                      # [OBLIGATORIA] activa validaciones de prod
AUTH_SECRET=REEMPLAZAR_CADENA_ALEATORIA_32+ # [OBLIGATORIA] >=32 chars en prod
AUTH_JWT_ALGORITHM=HS256
AUTH_TOKEN_EXPIRE_HOURS=24

# --- Workana (sesion) ---------------------------------------------------------
# Por defecto NO se usa sesion (scraping publico). Activar solo con state.json
# generado NATIVO de este contenedor.
WORKANA_USE_SESSION=false
STATE_FILE_PATH=/usr/src/app/state.json

# --- Tarifas (opcionales; si faltan, default 18) ------------------------------
HOURLY_RATE_PROJECT_FIXED=18
HOURLY_RATE_STAFF_AUGMENTATION=18
POST_DISCOVERY_HOURLY_RATE=18

# --- Limites de negocio -------------------------------------------------------
MIN_SCORE_FOR_AUTO_SEND=90
CONNECTS_AVAILABLE=50
MAX_PROJECT_DAYS=2
